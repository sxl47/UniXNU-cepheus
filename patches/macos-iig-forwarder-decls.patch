diff --git a/iokit/IOKit/IOService.h b/iokit/IOKit/IOService.h
--- a/iokit/IOKit/IOService.h
+++ b/iokit/IOKit/IOService.h
@@ -401,6 +401,13 @@ struct OSObjectUserVars;
 struct IOServiceStateChangeVars;
 struct IOInterruptSourcePrivate;
 
+#if PRIVATE_WIFI_ONLY
+/* OSObject.iig:127 -- OSContainer is a typedef of OSObject; identical
+ * typedef redeclaration is legal in C++, so this is safe whether or
+ * not the iig-generated header was included first. */
+typedef OSObject OSContainer;
+#endif /* PRIVATE_WIFI_ONLY */
+
 class IOService : public IORegistryEntry
 {
 	OSDeclareDefaultStructorsWithDispatch(IOService);

