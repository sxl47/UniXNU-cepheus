-/*
- * Apple's iig emits the DriverKit-facing forwarders and the TYPE(...) OSAction
- * factories into the generated .iig.cpp, which the kernel build does not
- * compile. The Linux iig shim generates the declarations but not these
- * definitions, so spell out the ones the kernel actually calls.
- */
-kern_return_t
-IOService::UserSetProperties(OSContainer * properties)
-{
-	return UserSetProperties_Impl(properties);
-}
-
-kern_return_t
-IOService::SendIOMessageServicePropertyChange(void)
-{
-	return SendIOMessageServicePropertyChange_Impl();
-}
 #endif /* PRIVATE_WIFI_ONLY */
 
