+/*
+ * Privileges for non-root processes come from MAC policies (priv_check_cred
+ * -> mac_priv_grant); on iOS Sandbox/AMFI grant them. Without a grant UIKit
+ * apps die in CoreAnimation setup: work_interval_create(CA_CLIENT) needs
+ * PRIV_WORK_INTERVAL ("Failed to create work interval", SpringBoard).
+ * Grant that one; log the first denial of each other privilege per process.
+ */
+#define CEPHEUS_PRIV_LOG_MAX      64
+static struct {
+	int  priv;
+	char name[20];
+} cepheus_priv_logged[CEPHEUS_PRIV_LOG_MAX];
+static int cepheus_priv_logged_count;
+
+static int
+cepheus_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
+{
+	if (priv == PRIV_WORK_INTERVAL) {
+		return 0;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	for (int i = 0; i < cepheus_priv_logged_count; i++) {
+		if (cepheus_priv_logged[i].priv == priv &&
+		    strncmp(cepheus_priv_logged[i].name, name, sizeof(name)) == 0) {
+			return EPERM;
+		}
+	}
+	if (cepheus_priv_logged_count < CEPHEUS_PRIV_LOG_MAX) {
+		cepheus_priv_logged[cepheus_priv_logged_count].priv = priv;
+		strlcpy(cepheus_priv_logged[cepheus_priv_logged_count].name, name, sizeof(name));
+		cepheus_priv_logged_count++;
+		printf("CEPHEUS Sandbox: %s privilege %d denied\n", name, priv);
+	}
+	return EPERM;
+}
+
 static const struct mac_policy_ops cepheus_sandbox_mac_ops = {
 	.mpo_policy_syscall = cepheus_sandbox_syscall,
+	.mpo_priv_grant = cepheus_sandbox_priv_grant,
 };
 
 static struct mac_policy_conf cepheus_sandbox_mac_conf = {
