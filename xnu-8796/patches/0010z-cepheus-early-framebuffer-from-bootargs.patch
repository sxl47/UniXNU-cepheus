diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index abfc169..ec3e53b 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -347,6 +347,69 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+#if defined(CEPHEUS)
+	/*
+	 * Two fat blocks above the assembly checkpoints, because "no text on
+	 * screen" still has two possible causes and a photo has to separate them.
+	 * They are deliberately not thin bands: on hardware the firmware paints a
+	 * full-width green bar across the bottom of the panel, and the first
+	 * version of these markers was a pair of 64x8 cyan / pale bands sitting
+	 * inside that bar -- green on green, unreadable. start.s lays a black
+	 * backdrop behind this whole area before any colour goes down.
+	 *
+	 * Every number here comes from the framebuffer record that start.s
+	 * publishes in cepheus_early.c, never from args. The previous version read
+	 * args->Video and died on that load on every boot: args is a KVA, and a
+	 * KVA read faults outright if the bootstrap window does not cover the
+	 * boot_args pages -- which sit below the kernel image, outside the window
+	 * start.s builds. Plain loads are also free to move above a volatile
+	 * store loop, so the fault ran before the blocks and nothing was painted.
+	 *
+	 *   lower block (white, 160x24) at row (height-160), x 240..399
+	 *   upper block (yellow, 200x24) at row (height-192), x 240..439
+	 *
+	 * Neither     => the branch into arm_init() never landed, so the entry
+	 *                path itself is still broken.
+	 * Both        => arm_init()'s first statements ran and the framebuffer
+	 *                record is usable, so whatever dies next dies later.
+	 */
+	{
+		uint32_t fb = cepheus_fb_base;
+		uint32_t stride = cepheus_fb_row_bytes / sizeof(uint32_t);
+		uint32_t height = cepheus_fb_height;
+
+		if (fb != 0 && stride != 0 && height > 192) {
+			volatile uint32_t *row = (volatile uint32_t *)(uintptr_t)fb +
+			    (size_t)(height - 160) * stride;
+			for (unsigned int r = 0; r < 24; r++) {
+				for (unsigned int c = 0; c < 160; c++) {
+					row[240 + c] = 0xffffffffu;
+				}
+				row += stride;
+			}
+			row = (volatile uint32_t *)(uintptr_t)fb +
+			    (size_t)(height - 192) * stride;
+			for (unsigned int r = 0; r < 24; r++) {
+				for (unsigned int c = 0; c < 200; c++) {
+					row[240 + c] = 0xffffff00u;
+				}
+				row += stride;
+			}
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+	}
+	/* Nothing below may be hoisted above the blocks: this is the barrier. */
+	__asm__ volatile("" ::: "memory");
+	/*
+	 * Point the C-side marks and panics at the same surface, still without
+	 * touching args.
+	 */
+	cepheus_early_video((uintptr_t)cepheus_fb_base, cepheus_fb_row_bytes,
+	    cepheus_fb_width, cepheus_fb_height);
+#endif
+	/* Raw boot_args quads; the implementation lives in cepheus_early.c. */
+extern void cepheus_early_boot_dump(const volatile void *p, const char *tag);
+extern volatile unsigned long cepheus_boot_regs[24];
 	cepheus_early_mark(1, "arm_init entered (MMU on)");
 
 	arm_setup_pre_sign();
@@ -355,5 +418,10 @@ arm_init(
 	/* If kernel integrity is supported, use a constant copy of the boot args. */
+	cepheus_early_boot_dump(cepheus_boot_regs, "regs0");
+	cepheus_early_boot_dump(cepheus_boot_regs + 17, "regs1");
+	cepheus_early_boot_dump((const volatile void *)cepheus_boot_regs[0], "args-PA");
+	cepheus_early_boot_dump(args, "post-slide");
 	const_boot_args = *args;
 	BootArgs = args = &const_boot_args;
+	cepheus_early_boot_dump(args, "const-copy");
 
 	cpu_data_init(&BootCpuData);

