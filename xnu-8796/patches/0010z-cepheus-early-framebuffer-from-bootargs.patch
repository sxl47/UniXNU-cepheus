@@ -62,7 +78,7 @@ cepheus_early_putc(char c)
 	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
 	for (unsigned int gy = 0; gy < 16; gy++) {
 		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
-			volatile uint32_t *line = EARLY_FB +
+			volatile uint32_t *line = EARLY_PTR +
 			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
 			    early_col * EARLY_CELL_W;
 			for (unsigned int gx = 0; gx < 8; gx++) {
@@ -91,9 +107,14 @@ cepheus_early_mark(unsigned int stage, const char *label)
 		return;
 	}
 	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
-	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 64; x < (stage + 1) * 64; x++) {
-			EARLY_FB[y * EARLY_STRIDE + x] = color;
+	unsigned int x_end = (stage + 1) * 64;
+
+	if (x_end > early_width) {
+		x_end = early_width;
+	}
+	for (unsigned int y = early_height - EARLY_BAND; y < early_height; y++) {
+		for (unsigned int x = stage * 64; x < x_end; x++) {
+			EARLY_PTR[y * EARLY_STRIDE + x] = color;
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
@@ -104,6 +125,117 @@ cepheus_early_mark(unsigned int stage, const char *label)
 	cepheus_early_putc('\n');
 }
 
+static void
+cepheus_early_hex_digits(uintptr_t v, unsigned int digits)
+{
+	static const char chars[] = "0123456789abcdef";
+
+	for (int shift = (int)(digits * 4) - 4; shift >= 0; shift -= 4) {
+		cepheus_early_putc(chars[(v >> shift) & 0xf]);
+	}
+}
+
+static void
+cepheus_early_hex(uintptr_t v)
+{
+	cepheus_early_hex_digits(v, 16);
+}
+
+static void
+cepheus_early_hex32(unsigned int v)
+{
+	cepheus_early_hex_digits(v, 8);
+}
+
+/*
+ * Adopt the framebuffer the loader actually used. Called from arm_init() with
+ * boot_args->Video before the first checkpoint, so every later mark and every
+ * panic lands on the screen a human is looking at instead of on the address
+ * start.s had to guess (and already used for the stage-0 band).
+ *
+ * The report is printed unconditionally: "no CEPHEUS EARLY 0 line" must mean
+ * "arm_init() was never reached", never "the console silently disagreed about
+ * the mode".
+ */
+void
+cepheus_early_video(uintptr_t base, unsigned int row_bytes,
+    unsigned int width, unsigned int height)
+{
+	/* One full cell plus the bottom band has to fit, or the console has zero
+	 * rows and the first newline would divide by zero. */
+	int usable = base != 0 && width >= EARLY_CELL_W &&
+	    height >= EARLY_BAND + EARLY_CELL_H && row_bytes >= width * 4u;
+
+	if (usable) {
+		early_fb = base;
+		early_width = width;
+		early_height = height;
+		early_row_bytes = row_bytes;
+		early_rows = (height - EARLY_BAND) / EARLY_CELL_H;
+		early_cols = width / EARLY_CELL_W;
+		early_row = 0;
+		early_col = 0;
+		early_started = 0;
+	}
+
+	cepheus_early_mark(0, usable ? "fb=boot_args pa=0x" :
+	    "fb=boot_args BAD, using 0x");
+	cepheus_early_hex(early_fb);
+	if (usable) {
+		cepheus_early_string(" w=0x");
+		cepheus_early_hex32(early_width);
+		cepheus_early_string(" h=0x");
+		cepheus_early_hex32(early_height);
+		cepheus_early_string(" row=0x");
+		cepheus_early_hex32(early_row_bytes);
+	} else {
+		cepheus_early_string(" raw pa=0x");
+		cepheus_early_hex(base);
+		cepheus_early_string(" w=0x");
+		cepheus_early_hex32(width);
+		cepheus_early_string(" h=0x");
+		cepheus_early_hex32(height);
+		cepheus_early_string(" row=0x");
+		cepheus_early_hex32(row_bytes);
+	}
+	cepheus_early_putc('\n');
+}
+
+/*
+ * Raw boot-args visibility dump, called from start.s right after it
+ * publishes the framebuffer record and before it branches into
+ * arm_init().  p points at boot_args (PA while start.s still runs in
+ * the V=P window, KVA later -- both readable through the bootstrap
+ * page table).  The first 0x11 quadwords cover Revision/Version,
+ * virtBase, physBase, memSize, topOfKernelData, Video[0..5],
+ * machineType, deviceTreeP and deviceTreeLength -- exactly the fields
+ * PE_init_platform()/SecureDTInit() die on when the loader handoff is
+ * wrong.
+ */
+void
+cepheus_early_boot_dump(const volatile void *p, const char *tag)
+{
+	unsigned int i;
+
+	if (cepheus_fb_base == 0 || cepheus_fb_row_bytes == 0) {
+		return;
+	}
+	cepheus_early_string("CEPHEUS ARGS ");
+	cepheus_early_string(tag ? tag : "DUMP");
+	cepheus_early_string(" @0x");
+	cepheus_early_hex((uintptr_t)p);
+	cepheus_early_putc('\n');
+	for (i = 0; i < 0x11; i++) {
+		cepheus_early_string("a[0x");
+		cepheus_early_hex_digits(i, 2);
+		cepheus_early_string("]=");
+		cepheus_early_hex(((const volatile uint64_t *)p)[i]);
+		cepheus_early_putc('\n');
+	}
+}
+
+/* Register/page-table record start.s publishes for arm_init(). */
+volatile unsigned long cepheus_boot_regs[24];
 void
 cepheus_early_panic(const char *fmt, va_list *args)
 {
