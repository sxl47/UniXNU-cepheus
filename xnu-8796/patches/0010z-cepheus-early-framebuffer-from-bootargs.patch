diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index abfc169..ec3e53b 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -347,6 +347,64 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+	/*
+	 * Two fat blocks above the assembly checkpoints, because "no text on
+	 * screen" still has three possible causes and a photo has to separate
+	 * them. They are deliberately not thin bands: on hardware the firmware
+	 * paints a full-width green bar across the bottom of the panel, and the
+	 * first version of these two markers was a pair of 64x8 cyan / pale
+	 * bands sitting inside that bar -- green on green, unreadable. start.s
+	 * lays a black backdrop behind this whole area before any colour goes
+	 * down, so everything here is drawn on black.
+	 *
+	 *   lower block (white, 160x24)  hardcoded 0x90000000 / 4320 / 2340 and
+	 *      touches no state at all. Seeing it means plain C stores through
+	 *      the framebuffer mapping reach the panel from inside arm_init().
+	 *   upper block (yellow, 200x24) same shape, but every number comes from
+	 *      args->Video. Seeing it means boot_args is dereferenceable here.
+	 *
+	 * Neither     => the ret out of start.s never landed in this function.
+	 * White only  => args->Video faults, so the boot_args pointer handed
+	 *                over by start.s is not usable.
+	 * Both        => entry path and args are fine, so cepheus_early_video()
+	 *                or cepheus_early_mark() is what leaves the screen dark.
+	 *
+	 * The identity V=P map is live and the framebuffer block is
+	 * Non-Cacheable by now (hardware: video pa 0x90000000, 1080x2340,
+	 * row 4320), so these stores need no cache maintenance.
+	 */
+	{
+		volatile uint32_t *row = (volatile uint32_t *)0x90000000ul +
+		    (2340u - 160u) * (4320u / sizeof(uint32_t));
+		for (unsigned int r = 0; r < 24; r++) {
+			for (unsigned int c = 0; c < 160; c++) {
+				row[240 + c] = 0xffffffffu;
+			}
+			row += 4320u / sizeof(uint32_t);
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	{
+		volatile uint32_t *row = (volatile uint32_t *)
+		    (args->Video.v_baseAddr +
+		    (args->Video.v_height - 192) * args->Video.v_rowBytes);
+		for (unsigned int r = 0; r < 24; r++) {
+			for (unsigned int c = 0; c < 200; c++) {
+				row[240 + c] = 0xffffff00u;
+			}
+			row += args->Video.v_rowBytes / sizeof(uint32_t);
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	/*
+	 * Follow the firmware's framebuffer before drawing anything: the splash
+	 * address baked into cepheus_early.c is a guess taken from the SoC DTs,
+	 * while args->Video is the surface the loader actually had on screen.
+	 * start.s already preferred args->Video for the stage-0 band; this makes
+	 * the C-side marks and panics follow the same surface.
+	 */
+	cepheus_early_video(args->Video.v_baseAddr, args->Video.v_rowBytes,
+	    args->Video.v_width, args->Video.v_height);
 	cepheus_early_mark(1, "arm_init entered (MMU on)");
 
 	arm_setup_pre_sign();

