@@ -2158,8 +2158,46 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
-	/* The framebuffer VA=PA mapping belongs to the outgoing TTBR0. */
+#if defined(CEPHEUS)
+	/*
+	 * The framebuffer's VA=PA mapping belongs to the outgoing TTBR0. Before
+	 * dropping it, move the early console onto the permanent physmap alias of
+	 * the same physical surface. arm_vm_physmap_init() above has already
+	 * mapped the whole RAM window (the splash carveout sits inside it), so
+	 * a PTOV entry describes a real kernel mapping in the tables that survive
+	 * the switch -- no reserved VA and no hand-built TTE required. If firmware
+	 * handed over a framebuffer outside RAM, fall back to switching the
+	 * console off instead of faulting.
+	 */
+	const uintptr_t early_fb_pa = cepheus_early_fb_phys();
+	const uint64_t early_fb_bytes = cepheus_early_fb_bytes();
+	vm_map_address_t early_fb_va = 0;
+
+	/*
+	 * Do not trust phystokv()'s fallback path here: it can synthesise an
+	 * address that was never mapped. Require a PTOV entry that covers the
+	 * whole framebuffer, so the switch below is guaranteed to hit DRAM.
+	 */
+	for (size_t i = 0; i < PTOV_TABLE_SIZE && ptov_table[i].len != 0; i++) {
+		if (early_fb_pa >= ptov_table[i].pa &&
+		    early_fb_pa - ptov_table[i].pa < ptov_table[i].len &&
+		    early_fb_bytes <=
+		    ptov_table[i].len - (early_fb_pa - ptov_table[i].pa)) {
+			early_fb_va = ptov_table[i].va +
+			    (early_fb_pa - ptov_table[i].pa);
+			break;
+		}
+	}
+
+	if (early_fb_va != 0) {
+		cepheus_early_relocate(early_fb_va);
+	} else {
+		cepheus_early_mark(8, "fb outside physmap; console off");
+		cepheus_early_disable();
+	}
+#else
 	cepheus_early_disable();
+#endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
@@ -2167,6 +2205,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	// global table pointers may need to be different due to physical aperture remapping
 	cpu_tte = (tt_entry_t*)(phystokv(cpu_ttep));
 	invalid_tte = (tt_entry_t*)(phystokv(invalid_ttep));
+	cepheus_early_mark(10, "TTBR0 off; TLB flushed");
 
 	// From here on out, we're off the bootstrap translation tables.
 
@@ -2259,7 +2298,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
     }
 #endif
 #endif
+	cepheus_early_mark(12, "calling pmap_bootstrap");
 	pmap_bootstrap(dynamic_memory_begin);
+	cepheus_early_mark(13, "pmap_bootstrap done");
 
